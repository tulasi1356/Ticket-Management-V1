# Copy to ".env" next to the Gemfile. Restart Rails + Sidekiq after changes.

SENDGRID_API_KEY=
# Verified Single Sender in SendGrid (plain email or "Name <email@domain.com>")
SENDGRID_FROM_EMAIL=

# Optional: send EVERY admin export to this address only (overrides the logged-in admin's email).
# Example: EXPORT_MAIL_TO=adminticketingsystem@yopmail.com
# EXPORT_MAIL_TO=

# Optional HELO domain for SMTP
# MAILER_DOMAIN=localhost
